VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only variables for Vercel email functions.
# Resend (primary). Verify the sending domain in Resend first.
RESEND_API_KEY=re_your-api-key
EMAIL_FROM=banbe <no-reply@banbe.app>

# Gmail fallback, used only when RESEND_API_KEY is unset.
GMAIL_USER=your-sender@gmail.com
# Create in Google Account > Security > 2-Step Verification > App passwords.
GMAIL_APP_PASSWORD=your-app-password

# Server-only credentials used to generate auth links without Supabase sending email.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Must be allowed in Supabase Authentication > URL Configuration.
AUTH_REDIRECT_URL=https://your-deployed-app.example/

# R2 hybrid public media (see .claude/notes/28-r2-hybrid-media.md). Leave empty to keep reading from Supabase.
# VITE_MEDIA_PUBLIC_BASE_URL=
# VITE_MEDIA_R2_READS=

# ---- Cloudflare R2 public-media hybrid (server only; see .claude/notes/28-r2-hybrid-media.md) ----
# Everything below unset => feature fully OFF; uploads/reads keep using Supabase Storage.
# R2 API token: "Object Read & Write", restricted to ONLY the two buckets below. Never reuse it for anything else.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BUCKET=banbe-media-public     # served ONLY via the custom domain below (never r2.dev)
# R2_STAGING_BUCKET=banbe-media-staging   # private, no public access, 1-day lifecycle expiry
# MEDIA_PUBLIC_BASE_URL=https://media.example.com
# CDN purge: API token scoped to "Zone > Cache Purge" on the media zone ONLY.
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_PURGE_TOKEN=
# Rollout: off | allowlist | percent | on
# MEDIA_R2_UPLOADS=off
# MEDIA_R2_UPLOAD_USER_IDS=            # comma-separated auth user ids (allowlist mode)
# MEDIA_R2_UPLOAD_PERCENT=0            # percent mode
# MEDIA_UPLOADS_PER_HOUR=60
# MEDIA_MAX_PENDING=24
# CRON_SECRET must be set for the media-sweep cron (it fails closed).

# Apple MapKit JS (web maps + address search) — OFF until all of these are set.
# Needs an Apple Developer Program membership: create a Maps ID + a Maps key (.p8) in the developer portal.
# VITE_MAPKIT_ENABLED=true              # build-time switch; unset = OpenStreetMap (MapLibre + Nominatim)
# MAPKIT_TEAM_ID=
# MAPKIT_KEY_ID=
# MAPKIT_PRIVATE_KEY=                   # contents of the .p8 (literal \n sequences are fine)

# Apple Push Notifications (docs/push-setup.md) — OFF until all three are set. Token-based (.p8) auth.
# Needs an Apple Developer Program membership: Keys > + > Apple Push Notifications service (APNs).
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY=                     # contents of the .p8 (literal \n sequences are fine)
# APNS_TOPIC=com.banbe.ios              # optional
# CRON_SECRET is also the bearer the database sends to /api/cron?job=push-drain (Supabase Vault 'push_drain_secret').
