# Supabase CLI local link cache — holds the project ref, org id, and pooler
# hostname for whichever project this machine is linked to; never commit it.
/supabase/.temp/
/supabase/.branches/

# iOS app (apps/ios) — generated by XcodeGen from project.yml, never hand-
# edited and never committed; regenerate with `xcodegen generate`.
/apps/ios/BanbeApp.xcodeproj/
/apps/ios/.build/
/apps/ios/DerivedData/

# SweetPad's generated SourceKit-LSP build server config — machine-local
# absolute paths, regenerated automatically per machine.
/buildServer.json
