# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Supabase CLI local link cache — holds the project ref, org id, and pooler
# hostname for whichever project this machine is linked to; never commit it.
/supabase/.temp/
/supabase/.branches/

# iOS app (apps/ios) — generated by XcodeGen from project.yml, never hand-
# edited and never committed; regenerate with `xcodegen generate`.
/apps/ios/BanbeApp.xcodeproj/
/apps/ios/.build/
/apps/ios/DerivedData/

# SweetPad's generated SourceKit-LSP build server config — machine-local
# absolute paths, regenerated automatically per machine.
/buildServer.json

# iOS Screenshot Catalog (scripts/capture_ios_catalog.sh) — regenerate
# locally with that script. The xcresult/export scratch space is always
# ignored; only the PNGs under docs/demo-screenshots are ignored by
# default — README.md/manifest.json stay tracked so a PR can be reviewed
# without needing to regenerate images first. Ask before committing the
# PNGs themselves.
/output/ios-screenshot-catalog/
/docs/demo-screenshots/**/*.png

# LOCAL TEST HARNESS — never deployed; `supabase db push` only reads
# supabase/migrations/*.sql, so nothing here can ever be applied. Kept local
# on purpose: it recreates the storage/auth scaffolding a bare Postgres lacks,
# which is worthless (and misleading) anywhere but a throwaway container.
# Run it with ./supabase/_localtest/run.sh
/supabase/_localtest/*
# ...except the rewards harness (audited 2026-10-10: only fake @test.dev users/phones and the public local-docker
# defaults from the README; no secrets). 13_rewards_run.sh needs 00_bootstrap_storage.sql + 01_seed.sql too (re-read: schema scaffolding + fake users/events only).
!/supabase/_localtest/README.md
!/supabase/_localtest/00_bootstrap_storage.sql
!/supabase/_localtest/01_seed.sql
!/supabase/_localtest/13_rewards_run.sh
!/supabase/_localtest/13_rewards_assert.sql
!/supabase/_localtest/13b_concurrent_redeem.sh
!/supabase/_localtest/14_rewards_timezone_run.sh
!/supabase/_localtest/14_rewards_timezone_assert.sql
!/supabase/_localtest/15_rewards_risk_run.sh
!/supabase/_localtest/15_rewards_risk_assert.sql
!/supabase/_localtest/16_rewards_kinds_run.sh
!/supabase/_localtest/16a_kinds_before.sql
!/supabase/_localtest/16b_kinds_after.sql
!/supabase/_localtest/17_rewards_partner_draft_run.sh
!/supabase/_localtest/17_rewards_partner_draft_assert.sql
!/supabase/_localtest/18_rewards_events_run.sh
!/supabase/_localtest/18a_events_before.sql
!/supabase/_localtest/18b_events_after.sql
# Rewards v2 suites (191+): same rules, fake @test.dev data only.
!/supabase/_localtest/2[0-9]*_rewards_*
# Retention-plan run (2026-10-23): push, US tz/currency, measurement/age, quick wins/core loops, digest
!/supabase/_localtest/2[3-9]_*_assert.sql
!/supabase/_localtest/24_event_tz_currency_run.sh
!/supabase/_localtest/retention_suites_run.sh
.migration-state/
