# Copy to .r2-secrets.local, fill in, then: chmod 600 .r2-secrets.local
# This file is git-ignored. NEVER paste these values into chat, a ticket or a commit.
# Only the local one-off scripts read it: scripts/r2-preflight.mjs and
# scripts/migrate-media-to-r2.mjs. The deployed app reads the SAME names from
# Vercel → Settings → Environment Variables (enter them there directly).

# ---- Supabase (already in .env.local on this machine; kept here so the
# ---- scripts run from one file. Service role: server-side only.)
SUPABASE_URL=https://ukchdgdnwytretvqjjqu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cloudflare R2 (S3 API token: Object Read & Write on the two buckets ONLY)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=banbe-media-public
R2_STAGING_BUCKET=banbe-media-staging
# Dedicated PRIVATE bucket for the Supabase backup job (`npm run backup:supabase`).
# Create it in the R2 dashboard and give the backup token access to it; without
# this the job falls back to the staging bucket, which may expire objects.
# R2_BACKUP_BUCKET=banbe-backups
# Public custom domain, NO trailing slash. Must be the R2 custom domain, never r2.dev.
MEDIA_PUBLIC_BASE_URL=https://media.banbe.app

# ---- Optional: CDN purge (Cloudflare API token, Zone > Cache Purge on banbe.app ONLY)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=

# ---- Rollout flags (must match Vercel once uploads are enabled)
MEDIA_R2_UPLOADS=off
MEDIA_UPLOADS_PER_HOUR=60
MEDIA_MAX_PENDING=24
