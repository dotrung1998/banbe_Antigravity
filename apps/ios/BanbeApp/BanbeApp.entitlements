<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately empty: no aps-environment key here. A free/personal
	     Apple ID cannot provision the Push Notifications capability at
	     all, and Xcode tries to provision whatever capability a key names
	     regardless of that key's VALUE — "development" vs "production"
	     doesn't matter, only whether the key exists. This is the
	     ENABLE_PUSH=NO entitlements file (Config/Debug.xcconfig); the
	     ENABLE_PUSH=YES one, BanbeAppPush.entitlements, is what actually
	     declares aps-environment. See .claude/notes/07-notifications.md
	     for the one-line switch to flip once a paid Apple Developer
	     account exists. -->
	<!-- TASK D (2026-10-01 UX foundation pass) — Associated Domains, unlike
	     Push, works on a free/personal team, so this is safe to declare
	     here unconditionally. Universal links only actually resolve once
	     public/.well-known/apple-app-site-association's "TEAMID" placeholder
	     is replaced with the real Apple Developer Team ID and the site is
	     deployed — until then iOS silently falls back to opening the plain
	     web URL, which is the documented, non-broken degraded state, not a
	     crash. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:banbe.app</string>
	</array>
</dict>
</plist>
