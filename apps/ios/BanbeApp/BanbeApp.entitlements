<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "development" here; Xcode/App Store Connect rewrites this to
	     "production" automatically for a real distribution build — this
	     value only matters for local debug builds. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
