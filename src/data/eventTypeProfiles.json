          { "id": "dietary:vegan", "field": "dietary", "value": "vegan", "vi": "Thuần chay", "en": "Vegan" },
          { "id": "byo:any", "field": "byo", "value": ["wine", "any"], "vi": "Được mang đồ uống", "en": "BYO" }
        ]
      }
    },
