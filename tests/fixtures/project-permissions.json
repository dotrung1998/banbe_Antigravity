    { "case": "extend delegated grants", "action": "grants.extend", "allow": ["@hosts"] },

    { "case": "read-only after event + 30 days: no writes, even for the Host", "action": "task.manage", "now": "2026-12-16T09:00:00+07:00", "target": { "laneId": "menu" }, "allow": [] },
    { "case": "read-only: ticking stops too", "action": "ros.tick", "now": "2026-12-16T09:00:00+07:00", "allow": [] },
    { "case": "read-only: the project stays readable", "action": "project.read", "now": "2026-12-16T09:00:00+07:00", "allow": ["@all"] },
    { "case": "read-only: channels stay openable", "action": "channels.open", "now": "2026-12-16T09:00:00+07:00", "allow": ["@all"] },

    { "case": "check-in with delegation off: today's organizer accounts only", "action": "checkin", "allow": ["@hosts"], "allowOwnerOnly": ["@hosts"] },
    { "case": "check-in delegated: finance and granted helpers", "action": "checkin", "flags": { "event_project_hub": true, "project_delegate_checkin": true }, "allow": ["@hosts", "finance", "helper_checkin"], "allowOwnerOnly": ["@hosts", "finance", "helper_checkin"] },
    { "case": "check-in delegated but the grant expired", "action": "checkin", "now": "2026-11-23T09:00:00+07:00", "flags": { "event_project_hub": true, "project_delegate_checkin": true }, "allow": ["@hosts"], "allowOwnerOnly": ["@hosts"] },
    { "case": "check-in delegated but the hub is off", "action": "checkin", "flags": { "event_project_hub": false, "project_delegate_checkin": true }, "allow": ["@hosts"], "allowOwnerOnly": ["@hosts"] },
    { "case": "confirm payment with delegation off", "action": "money.confirm", "allow": ["@hosts"], "allowOwnerOnly": ["@hosts"] },
    { "case": "confirm payment delegated: money capability only (not check-in)", "action": "money.confirm", "flags": { "event_project_hub": true, "project_delegate_payments": true }, "allow": ["@hosts", "finance", "helper_money"], "allowOwnerOnly": ["@hosts", "finance", "helper_money"] },
    { "case": "see amounts delegated", "action": "money.view", "flags": { "event_project_hub": true, "project_delegate_payments": true }, "allow": ["@hosts", "finance", "helper_money"], "allowOwnerOnly": ["@hosts", "finance", "helper_money"] },
    { "case": "open the transfer proof of a booking awaiting confirmation", "action": "proof.open", "flags": { "event_project_hub": true, "project_delegate_payments": true }, "target": { "awaitingVerification": true }, "allow": ["@hosts", "finance", "helper_money"], "allowOwnerOnly": ["@hosts", "finance", "helper_money"] },
    { "case": "no proof for a booking that is not awaiting confirmation", "action": "proof.open", "flags": { "event_project_hub": true, "project_delegate_payments": true }, "target": { "awaitingVerification": false }, "allow": ["@hosts"], "allowOwnerOnly": ["@hosts"] },
    { "case": "rejecting a pending payment is never delegated", "action": "money.reject", "flags": { "event_project_hub": true, "project_delegate_payments": true }, "allow": ["@hosts"], "allowOwnerOnly": ["@hosts"] },
    { "case": "request a refund send (delegates only)", "action": "refund.request", "flags": { "event_project_hub": true, "project_delegate_refunds": true }, "allow": ["finance", "helper_money"], "allowOwnerOnly": ["finance", "helper_money"] },
    { "case": "mark refund sent, approval by Host", "action": "refund.markSent", "flags": { "event_project_hub": true, "project_delegate_refunds": true }, "allow": ["@hosts"], "allowOwnerOnly": ["@hosts"] },
    { "case": "mark refund sent, finance may refund alone", "action": "refund.markSent", "flags": { "event_project_hub": true, "project_delegate_refunds": true }, "project": { "readOnlyAt": "2026-12-15T00:00:00+07:00", "refundApproval": "finance_alone" }, "allow": ["@hosts", "finance", "helper_money"], "allowOwnerOnly": ["@hosts", "finance", "helper_money"] },
    { "case": "approve a requested refund", "action": "refund.approve", "flags": { "event_project_hub": true, "project_delegate_refunds": true }, "allow": ["@hosts"], "allowOwnerOnly": ["@hosts"] },
    { "case": "refunds switch off: delegates get nothing even in finance-alone mode", "action": "refund.markSent", "project": { "readOnlyAt": "2026-12-15T00:00:00+07:00", "refundApproval": "finance_alone" }, "allow": ["@hosts"], "allowOwnerOnly": ["@hosts"] },

    { "case": "after read-only, an open dispute grant still allows refund actions on that claim", "action": "refund.markSent", "now": "2027-01-20T09:00:00+07:00", "flags": { "event_project_hub": true, "project_delegate_refunds": true }, "project": { "readOnlyAt": "2026-12-15T00:00:00+07:00", "refundApproval": "finance_alone" }, "target": { "refundClaimId": "c1" }, "disputeGrants": [{ "userId": "u_fin", "refundClaimId": "c1", "until": "2027-02-01T00:00:00+07:00", "disputeOpen": true }], "allow": ["@hosts", "finance"], "allowOwnerOnly": ["@hosts", "finance"] },
    { "case": "a dispute grant covers only its own claim", "action": "refund.markSent", "now": "2027-01-20T09:00:00+07:00", "flags": { "event_project_hub": true, "project_delegate_refunds": true }, "project": { "readOnlyAt": "2026-12-15T00:00:00+07:00", "refundApproval": "finance_alone" }, "target": { "refundClaimId": "c2" }, "disputeGrants": [{ "userId": "u_fin", "refundClaimId": "c1", "until": "2027-02-01T00:00:00+07:00", "disputeOpen": true }], "allow": ["@hosts"], "allowOwnerOnly": ["@hosts"] },
    { "case": "a dispute grant ends when the dispute closes", "action": "refund.markSent", "now": "2027-01-20T09:00:00+07:00", "flags": { "event_project_hub": true, "project_delegate_refunds": true }, "project": { "readOnlyAt": "2026-12-15T00:00:00+07:00", "refundApproval": "finance_alone" }, "target": { "refundClaimId": "c1" }, "disputeGrants": [{ "userId": "u_fin", "refundClaimId": "c1", "until": "2027-02-01T00:00:00+07:00", "disputeOpen": false }], "allow": ["@hosts"], "allowOwnerOnly": ["@hosts"] },
    { "case": "a dispute grant ends at its date", "action": "refund.request", "now": "2027-02-02T09:00:00+07:00", "flags": { "event_project_hub": true, "project_delegate_refunds": true }, "target": { "refundClaimId": "c1" }, "disputeGrants": [{ "userId": "u_fin", "refundClaimId": "c1", "until": "2027-02-01T00:00:00+07:00", "disputeOpen": true }], "allow": [], "allowOwnerOnly": [] },
    { "case": "a dispute grant never opens check-in", "action": "checkin", "now": "2027-01-20T09:00:00+07:00", "flags": { "event_project_hub": true, "project_delegate_checkin": true, "project_delegate_refunds": true }, "target": { "refundClaimId": "c1" }, "disputeGrants": [{ "userId": "u_fin", "refundClaimId": "c1", "until": "2027-02-01T00:00:00+07:00", "disputeOpen": true }], "allow": ["@hosts"], "allowOwnerOnly": ["@hosts"] },

    { "case": "an unknown action is refused", "action": "event.cancel", "allow": [], "allowOwnerOnly": [] }
