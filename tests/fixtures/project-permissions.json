    "helper_money": { "userId": "u_hm", "member": { "role": "helper", "laneId": null, "caps": { "money": true }, "status": "active" } },
    "helper_checkin": { "userId": "u_hc", "member": { "role": "helper", "laneId": null, "caps": { "checkin": true }, "status": "active" } },
    "removed_finance": { "userId": "u_rf", "member": { "role": "finance", "laneId": null, "caps": {}, "status": "removed" } },
    "outsider": { "userId": "u_out" }
  },
  "rows": [
