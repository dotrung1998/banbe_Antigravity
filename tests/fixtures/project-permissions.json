    { "case": "invite finance & door", "action": "invite.create", "target": { "role": "finance" }, "allow": ["@hosts"] },
    { "case": "invite a lane lead", "action": "invite.create", "target": { "role": "lane_lead" }, "allow": ["@hosts", "manager"] },
    { "case": "invite a helper", "action": "invite.create", "target": { "role": "helper" }, "allow": ["@hosts", "manager"] },
    { "case": "invite with an unknown role", "action": "invite.create", "target": { "role": "host" }, "allow": [] },
    { "case": "revoke a manager's own invite", "action": "invite.revoke", "target": { "createdBy": "u_mgr" }, "allow": ["@hosts", "manager"] },
    { "case": "revoke the Host's invite", "action": "invite.revoke", "target": { "createdBy": "u_owner" }, "allow": ["@hosts"] },
