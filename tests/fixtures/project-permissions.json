    { "case": "decide in the lead's lane", "action": "post.decision", "target": { "laneId": "menu" }, "allow": ["@hosts", "manager", "lead"] },
    { "case": "decide in another lane", "action": "post.decision", "target": { "laneId": "venue" }, "allow": ["@hosts", "manager"] },
    { "case": "resolve a question: author and addressee may", "action": "post.resolve", "target": { "type": "question", "state": "open", "laneId": "venue", "authorId": "u_help", "addresseeId": "u_fin" }, "allow": ["@hosts", "manager", "helper", "finance"] },
    { "case": "updates are never resolved", "action": "post.resolve", "target": { "type": "update", "state": "open", "laneId": "menu", "authorId": "u_owner" }, "allow": [] },
    { "case": "a resolved post cannot be resolved again", "action": "post.resolve", "target": { "type": "proposal", "state": "resolved", "laneId": "menu" }, "allow": [] },
