    { "case": "no edit once someone responded", "action": "post.edit", "target": { "type": "question", "state": "open", "authorId": "u_help", "quiet": false }, "allow": [] },
    { "case": "decisions are never edited", "action": "post.edit", "target": { "type": "decision", "state": "open", "authorId": "u_owner", "quiet": true }, "allow": [] },
    { "case": "delete a post others answered", "action": "post.delete", "target": { "type": "question", "state": "open", "authorId": "u_help", "quiet": false }, "allow": ["@hosts", "manager"] },
    { "case": "delete own quiet post", "action": "post.delete", "target": { "type": "question", "state": "open", "authorId": "u_help", "quiet": true }, "allow": ["@hosts", "manager", "helper"] },

