    { "case": "hub switch off: nobody can start one", "action": "project.start", "flags": { "event_project_hub": false }, "allow": [] },

    { "case": "status of a helper's task in another lane", "action": "task.status", "target": { "assigneeId": "u_help", "laneId": "venue" }, "allow": ["@hosts", "manager", "helper"] },
    { "case": "status of finance's task in the lead's lane", "action": "task.status", "target": { "assigneeId": "u_fin", "laneId": "menu" }, "allow": ["@hosts", "manager", "lead", "finance"] },
    { "case": "manage a task in the lead's lane", "action": "task.manage", "target": { "laneId": "menu" }, "allow": ["@hosts", "manager", "lead"] },
    { "case": "manage a task in another lane", "action": "task.manage", "target": { "laneId": "venue" }, "allow": ["@hosts", "manager"] },

    { "case": "ask a question", "action": "post.question", "allow": ["@all"] },
    { "case": "post an update", "action": "post.update", "allow": ["@all"] },
    { "case": "vote", "action": "post.vote", "allow": ["@all"] },
    { "case": "mark seen", "action": "post.seen", "allow": ["@all"] },
    { "case": "reply", "action": "post.reply", "allow": ["@all"] },
