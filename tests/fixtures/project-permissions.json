{
  "_about": "Event Project Hub permission vectors (note 76). Read by tests/unit/projectPermissions.test.mjs and apps/ios/BanbeAppTests/ProjectPermissionsTests.swift; migration 210-214 SQL tests reuse the rows. Each row is checked for EVERY actor under BOTH Host definitions. 'allow' is the 'either' answer (v1: both organizer accounts are the Host). 'allowOwnerOnly' is the 'owner_only' answer; when absent it equals 'allow' minus second_account, because under owner_only that account is just an outsider to the project. Rows with 'allowOwnerOnly' are money/door actions, which keep the existing RPCs' own owner_id-or-user_id check. Aliases: @hosts = both organizer accounts, @all = both organizer accounts and every active member.",
  "organizer": { "ownerId": "u_owner", "userId": "u_second" },
  "defaults": {
    "now": "2026-11-10T12:00:00+07:00",
    "flags": { "event_project_hub": true },
    "project": { "readOnlyAt": "2026-12-15T00:00:00+07:00", "refundApproval": "host" },
    "grantExpiresAt": "2026-11-22T00:00:00+07:00"
  },
  "actors": {
    "owner_account": { "userId": "u_owner" },
    "second_account": { "userId": "u_second" },
    "manager": { "userId": "u_mgr", "member": { "role": "manager", "laneId": null, "caps": {}, "status": "active" } },
    "finance": { "userId": "u_fin", "member": { "role": "finance", "laneId": null, "caps": { "money": false, "checkin": false }, "status": "active" } },
    "lead": { "userId": "u_lead", "member": { "role": "lane_lead", "laneId": "menu", "caps": {}, "status": "active" } },
