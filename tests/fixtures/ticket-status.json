{
  "cases": [
    {
      "case": "cancelled event beats a paid ticket",
      "in": {
        "paymentState": "confirmed",
        "eventCancelled": true,
        "isPaid": true,
        "daysUntil": 3
      },
      "expect": {
        "key": "cancelled",
        "tone": "alert",
        "qr": "void"
      }
    },
    {
      "case": "cancelled event beats holding",
      "in": {
        "paymentState": "holding",
        "eventCancelled": true
      },
      "expect": {
        "key": "cancelled",
        "tone": "alert",
        "qr": "void"
      }
    },
    {
      "case": "booking cancelled is not 'awaiting payment'",
      "in": {
        "paymentState": "cancelled"
      },
      "expect": {
        "key": "cancelled",
        "tone": "alert",
        "qr": "void"
      }
    },
    {
      "case": "hold expired",
      "in": {
        "paymentState": "expired"
      },
      "expect": {
        "key": "expired",
        "tone": "alert",
        "qr": "void"
      }
    },
    {
      "case": "disputed beats holding-like data",
      "in": {
        "paymentState": "disputed",
        "isPaid": false
      },
      "expect": {
        "key": "review",
        "tone": "honey",
        "qr": "lock"
      }
    },
    {
      "case": "holding",
      "in": {
        "paymentState": "holding"
      },
      "expect": {
        "key": "holding",
        "tone": "honey",
        "qr": "lock"
      }
    },
    {
      "case": "awaiting host",
      "in": {
        "paymentState": "pending_verification"
      },
      "expect": {
        "key": "awaiting",
        "tone": "plum",
        "qr": "lock"
      }
    },
    {
      "case": "ended beats checked in",
      "in": {
        "paymentState": "confirmed",
        "isPaid": true,
        "checkedIn": true,
        "endedHoursAgo": 2
      },
      "expect": {
        "key": "ended",
        "tone": "ink3",
        "qr": "past"
      }
    },
    {
      "case": "ended at exactly 0 hours ago is still ended",
      "in": {
        "paymentState": "confirmed",
        "isPaid": true,
        "endedHoursAgo": 0
      },
      "expect": {
        "key": "ended",
        "tone": "ink3",
        "qr": "past"
      }
    },
    {
      "case": "checked in beats today",
      "in": {
        "paymentState": "confirmed",
        "isPaid": true,
        "checkedIn": true,
        "daysUntil": 0
      },
      "expect": {
        "key": "checkedIn",
        "tone": "moss",
        "qr": "in"
      }
    },
    {
      "case": "today",
      "in": {
        "paymentState": "confirmed",
        "isPaid": true,
        "daysUntil": 0
      },
      "expect": {
        "key": "today",
        "tone": "clay",
        "qr": "ok"
      }
    },
    {
      "case": "tomorrow is upcoming",
      "in": {
        "paymentState": "confirmed",
        "isPaid": true,
        "daysUntil": 1
      },
      "expect": {
        "key": "upcoming",
        "tone": "mist",
        "qr": "ok"
      }
    },
    {
      "case": "unknown day count is upcoming",
      "in": {
        "paymentState": "confirmed",
        "isPaid": true,
        "daysUntil": null
      },
      "expect": {
        "key": "upcoming",
        "tone": "mist",
        "qr": "ok"
      }
    },
    {
      "case": "attended booking without payment_state still reads as paid (caller sets isPaid)",
      "in": {
        "paymentState": null,
        "isPaid": true,
        "checkedIn": true
      },
      "expect": {
        "key": "checkedIn",
        "tone": "moss",
        "qr": "in"
      }
    },
    {
      "case": "no booking, nothing to explain",
      "in": {},
      "expect": null
    },
    {
      "case": "unpaid with no phase gets no strip",
      "in": {
        "paymentState": null,
        "isPaid": false,
        "daysUntil": 0
      },
      "expect": null
    }
  ],
  "qrShowsToken": {
    "ok": true,
    "in": true,
    "lock": false,
    "void": false,
    "past": false,
    "": false
  },
  "entryCode": [
