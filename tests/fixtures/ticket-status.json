      "out": null
    },
    {
      "km": 9662,
      "located": true,
      "en": true,
      "out": null
    },
    {
      "km": 2.4,
      "located": false,
      "en": true,
      "out": null
    },
    {
      "km": 2.4,
      "located": null,
      "en": true,
      "out": null
    },
    {
      "km": null,
      "located": true,
      "en": true,
      "out": null
    }
  ],
  "doorWatch": [
    {
      "case": "single ticket, in the window, not checked in",
      "in": {
        "checkedIn": false,
        "startMs": 0,
        "nowMs": 7200000
      },
      "expect": true
    },
    {
      "case": "single ticket, checked in",
      "in": {
        "checkedIn": true,
        "startMs": 0,
        "nowMs": 7200000
      },
      "expect": false
    },
    {
      "case": "exactly 3h before the start is still outside",
      "in": {
        "checkedIn": false,
        "startMs": 0,
        "nowMs": -10800000
      },
      "expect": false
    },
    {
      "case": "1ms inside the opening edge",
      "in": {
        "checkedIn": false,
        "startMs": 0,
        "nowMs": -10799999
      },
      "expect": true
    },
    {
      "case": "1ms inside the closing edge",
      "in": {
        "checkedIn": false,
        "startMs": 0,
        "nowMs": 43199999
      },
      "expect": true
    },
    {
      "case": "exactly 12h after the start is outside",
      "in": {
        "checkedIn": false,
        "startMs": 0,
        "nowMs": 43200000
      },
      "expect": false
    },
    {
      "case": "no start time known",
      "in": {
        "checkedIn": false,
        "startMs": null,
        "nowMs": 0
      },
      "expect": false
    },
    {
      "case": "named: first of three scanned, the rest still open",
      "in": {
        "namedScans": [
          true,
          false,
          false
        ],
        "checkedIn": true,
        "startMs": 0,
        "nowMs": 3600000
      },
      "expect": true
    },
    {
      "case": "named: last open one scanned, so done",
      "in": {
        "namedScans": [
          true,
          true,
          true
        ],
        "checkedIn": true,
        "startMs": 0,
        "nowMs": 3600000
      },
      "expect": false
    },
    {
      "case": "named: some open but the window has closed",
      "in": {
        "namedScans": [
          true,
          false
        ],
        "checkedIn": true,
        "startMs": 0,
        "nowMs": 46800000
      },
      "expect": false
    },
    {
      "case": "named: none scanned yet, before the window opens",
      "in": {
        "namedScans": [
          false,
          false
        ],
        "checkedIn": false,
        "startMs": 0,
        "nowMs": -14400000
      },
      "expect": false
    },
    {
      "case": "named: the booking reading attended does not end it while a ticket is open",
      "in": {
        "namedScans": [
          true,
          false
        ],
        "checkedIn": true,
        "startMs": 0,
        "nowMs": 7200000
      },
      "expect": true
    },
    {
      "case": "empty named list falls back to the booking rule (not checked in)",
      "in": {
        "namedScans": [],
        "checkedIn": false,
        "startMs": 0,
        "nowMs": 7200000
      },
      "expect": true
    },
    {
      "case": "empty named list falls back to the booking rule (checked in)",
      "in": {
        "namedScans": [],
        "checkedIn": true,
        "startMs": 0,
        "nowMs": 7200000
      },
      "expect": false
    }
  ]
}
