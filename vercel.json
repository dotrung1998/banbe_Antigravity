{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/wallet-pass",
      "destination": "/api/wallet?op=pass"
    },
    {
      "source": "/api/wallet-refresh",
      "destination": "/api/wallet?op=refresh"
    },
    {
      "source": "/api/wallet/:path+",
      "destination": "/api/wallet?op=ws&path=:path+"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron?job=escalate-verifications",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron?job=purge-payment-documents",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron?job=wallet-pass-sweep",
      "schedule": "30 10 * * *"
    }
  ]
}
